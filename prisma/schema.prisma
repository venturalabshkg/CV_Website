generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime
}

model Profile {
  id               String   @id @default("profile")
  fullName         String
  initials         String   @default("YN")
  title            String
  introduction     String
  about            String
  location         String
  timezone         String   @default("UTC")
  availability     String
  email            String
  avatarUrl        String?
  resumeUrl        String?
  githubUsername   String?
  linkedinUrl      String?
  availableForWork Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model TechnologyCategory {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  order        Int          @default(0)
  visible      Boolean      @default(true)
  technologies Technology[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Technology {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  icon         String?
  url          String?
  categoryId   String
  category     TechnologyCategory     @relation(fields: [categoryId], references: [id])
  order        Int                    @default(0)
  visible      Boolean                @default(true)
  experiences  ExperienceTechnology[]
  projects     ProjectTechnology[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([categoryId, order])
}

model Experience {
  id               String                 @id @default(cuid())
  company          String
  title            String
  employmentType   String
  location         String?
  startDate        DateTime
  endDate          DateTime?
  current          Boolean                @default(false)
  description      String                 @default("")
  responsibilities String                 @default("")
  logoUrl          String?
  order            Int                    @default(0)
  visible          Boolean                @default(true)
  technologies     ExperienceTechnology[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([order])
}

model ExperienceTechnology {
  experienceId String
  technologyId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([experienceId, technologyId])
}

model ProjectCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  order     Int       @default(0)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id           String              @id @default(cuid())
  title        String
  slug         String              @unique
  summary      String
  description  String
  problem      String              @default("")
  challenges   String              @default("")
  approach     String              @default("")
  architecture String              @default("")
  thumbnailUrl String?
  githubUrl    String?
  demoUrl      String?
  featured     Boolean             @default(false)
  published    Boolean             @default(false)
  order        Int                 @default(0)
  categoryId   String?
  category     ProjectCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProjectImage[]
  technologies ProjectTechnology[]
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([published, featured, order])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  @@index([projectId, order])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String
  content        String
  coverUrl       String?
  published      Boolean       @default(false)
  featured       Boolean       @default(false)
  publishedAt    DateTime?
  readingTime    Int           @default(1)
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           BlogPostTag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([published, featured])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String
  startDate   DateTime?
  endDate     DateTime?
  description String    @default("")
  logoUrl     String?
  order       Int       @default(0)
  visible     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String
  url       String
  icon      String   @default("link")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String   @unique
  mimeType  String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WebsiteSettings {
  id             String   @id @default("default")
  siteName       String
  siteTitle      String
  logoText       String
  faviconUrl     String?
  description    String
  defaultTheme   String   @default("dark")
  seoTitle       String
  seoDescription String
  ogImageUrl     String?
  contactEmail   String
  accentColor    String   @default("#d4d4d8")
  footerNote     String
  showOverview   Boolean  @default(true)
  showGithub     Boolean  @default(true)
  showAbout      Boolean  @default(true)
  showStack      Boolean  @default(true)
  showExperience Boolean  @default(true)
  showProjects   Boolean  @default(true)
  showBlog       Boolean  @default(true)
  showEducation  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
