# SQLite is the local default so the CMS runs without a separate database server.
# For production, point DATABASE_URL at PostgreSQL and switch the Prisma provider.
DATABASE_URL="file:./dev.db"

# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Used only by `npm run setup` to create the first administrator.
# Later password changes are not read from here.
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional. Required for the live GitHub contribution graph.
GITHUB_TOKEN=""
GITHUB_USERNAME=""

# Used for sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
